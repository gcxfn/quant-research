        "dd_threshold": 0.08,
        "e_low": 0.2
      },
      "C12": {
        "mech": "X1",
        "e_low": 0.4
      }
    },
    "common": "W=W2S, N=3, e_on=0.90 (saturates to 25%/leg = 75% effective for N=3; written 0.90 to align B1(m) with R7 TREND)"
  },
  "exposure_mechanisms_daily": {
    "FIX75": {
      "exposure": 0.75,
      "note": "control anchor; zero risk trades; MUST reproduce R7 C01 equity curve bit-exact"
    },
    "T200": {
      "rule": "000300.SH close > SMA200(close, 200 index sessions incl. t) at session t -> e_on else e_low",
      "index": "000300.SH",
      "join": "index row with trade_date <= t (asof-backward)",
      "fallback": "SMA200 unavailable -> e_low"
    },
    "T60": {
      "rule": "same as T200 with SMA60",
      "fallback": "unavailable -> e_low"
    },
    "T20c2": {
      "rule": "close > SMA20 on 2 consecutive sessions (t-1 and t) -> e_on else e_low (fast-out slow-in: one day below exits, two days above re-enters)",
      "fallback": "insufficient history -> e_low"
    },
    "D252": {
      "rule": "close >= rolling 252-session peak x (1 - dd_threshold) -> e_on else e_low (rolling peak over index sessions ending t inclusive)",
      "fallback": "insufficient history -> e_low"
    },
    "D60": {
      "rule": "same as D252 over 60 sessions with dd_threshold 0.08"
    },
    "PDD": {
      "rule": "own-instance total equity (marked at session t close) >= running peak x (1 - dd_threshold) -> e_on else e_low; running peak resets never (all-time within simulation); path-dependent per instance (strategy / B1(m) / B3prime each use their own equity)",
      "fallback": "first sessions before any drawdown computable -> e_on"
    },
    "X1": {
      "rule": "risk-off (e_low) if T200 condition fires OR D252(0.10) condition fires; else e_on"
    },
    "warmup_guarantee": "2015 warmup provides >=200 index sessions before first 2016 session; SMA/peak windows fully formed at first judged session"
  },
  "risk_overlay_execution": {
    "state_change_only": "trade only when E_t != E_{t-1}; equal states -> no risk trades (incumbent weight drift preserved)",
    "retarget": "on the session after a state change, re-target ALL held legs to min(E_t/3, 0.25) x equity(t close); members unchanged, proportional scale; sells and buys at that session's open",
    "monthly_collision": "if a monthly rebalance and a risk state change coincide, compute ONE combined target (member updates x current E_t budget) and execute once at t+1 open",
    "postpone": "a re-sizing leg with no quote at t+1 (suspended) or open beyond +/-9.5% vs pre_close -> postpone to next tradable session open; if the target changes again while postponed, the LATEST target applies at the next tradable open; monthly slot_busy rule unchanged",
    "turnover_counting": "risk re-sizing buys count toward gate-5 buy notional; no exemption",
    "cash_discipline": "single cash pool never negative; buys additionally capped by cash available after same-session sells; capped budget <= commission_min -> skip leg (rule-compliant cash slot)"
  },
  "benchmarks": {
    "B1m_matched": "same eligible pool, equal weight, same monthly signal days, SAME mechanism DAILY exposure path (own-instance equity peak for PDD); per-leg = min(exposure_t/N_pool, 0.25) x base equity; idle cash carries forward (R7 fixed engine); gross AND net disclosed, net primary",
    "B1_at_100": "identical engine with exposure = 1.0 (reference; MUST reproduce R7 B1@100% dev +10.40% / +63.9% / -27.47%)",
    "B2": "inherited R7 (510300.SH segment buy-hold)",
    "B3prime": "random Top-3 through the same R8 engine, same mechanism exposure semantics (own-instance for PDD), seeds 17..36",
    "B4": 0.0
  },
  "gates": {
    "dev_all_required": {
      "1_net_cagr_gt_0": "dev net CAGR > 0",
      "2_excess_vs_B1m": "dev net CAGR - B1(m) dev net CAGR >= +0.020 (annualized, pp)",
      "3_positive_years": "net excess vs B1(m) > 0 in >= 4 of 5 dev calendar years",
      "4_drawdown": "dev max drawdown <= 0.20 AND <= B1(m) dev max drawdown",
      "5_turnover": "annual one-side (buy notional / mean equity) max over dev years <= 12.0; monthly sub-cap <= 6.0 (selection is monthly; risk overlay buys count, no exemption)",
      "6_concentration": "dev net profit top-1 code share <= 40% AND top-3 <= 70%",
      "7_vs_random": "dev net CAGR >= mean(B3prime 20 seeds, same mechanism, dev net CAGR) + 0.010 (limited power, noted)",
      "8_execution": "dev-window leg-level execution rate >= 0.95 (planned legs on dev signal days AND dev risk-state-change days; executed = filled / backfilled / rule-compliant cash slot incl. cash-capped / postponed-then-filled)"
    },
    "validation": [
      "val net CAGR excess vs B1(m) >= +0.010",
      "net excess vs B1(m) > 0 in both 2021 and 2022",
      "val max drawdown <= 0.20; turnover and concentration <= same dev-gate limits"
    ],
    "test_rule": "test net excess vs B1(m) >= 0 AND test max drawdown <= 0.20 => P3 candidate; test run once, terminal",
    "advancement": "all 12 judged on dev (second-reuse exploratory); among dev all-pass only the highest dev net excess vs B1(m) advances (tie: lower config id); at most 1 survivor; no all-pass -> record and close the direction (sub-monthly risk control incl. weekly), no re-grading, no criterion edits",
    "anchor_regressions_required_before_consumption": [
      "C01 equity curve bit-exact vs run 20260918T004441-p2r7-etf-exposure-d01f4e7a C01",
      "B1(FIX-75) matches that run's B1(FIX)",
      "B1@100% dev +10.40% / +63.9% / -27.47%"
    ],
    "trial_count_note": "cumulative trials: 115 (27 stock + 20 factor survey + 44 window diagnostic + 12 P2-R6 + 12 P2-R7) + 12 here = 127"
  },
  "preanalysis_sect0": {
